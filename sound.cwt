types = {
    ## type_key_filter = soundeffect
    type[soundeffect] = {
		path = "game/sound"
        name_field = "name"
		path_extension = .asset
    }
    ## type_key_filter = sound
    type[sound] = {
		path = "game/sound"
        name_field = "name"
		path_extension = .asset
    }
    ## type_key_filter = falloff
    type[falloff] = {
		path = "game/sound"
        name_field = "name"
		path_extension = .asset
    }
}

sound = {
    name = scalar
    file = filepath[sound/]
    ## cardinality = 0..1
    pan = float
    ## cardinality = 0..1
    priority = float
    ## cardinality = 0..1
    volume = float
    ## cardinality = 0..1
    always_load = bool
}

soundeffect = {
    name = scalar
    ## cardinality = 0..1
    falloff = <falloff>
    ## cardinality = ~1..inf
    alias_name[sounds] = alias_match_left[sounds]
    ## cardinality = 0..1
    loop = bool
    ## cardinality = 0..1
    is3d = bool
    ## cardinality = 0..1
    max_audible = int
    # what other types possible here?
    ## cardinality = 0..1
    max_audible_behaviour = enum[max_audible_behaviours]
    ## cardinality = 0..1
    volume = float
    ## cardinality = 0..1
    fade_in = float
    ## cardinality = 0..1
    fade_out = float
    ## cardinality = 0..1
    delay_random_offset = {
        ## cardinality = 2..2
        float
    }
    ## cardinality = 0..1
    volume_random_offset = {
        ## cardinality = 2..2
        float
    }
}
alias[soundgroup:sounds] = {
    ## cardinality = ~1..inf
    sound = <sound>
}
alias[soundgroup:sounds] = {
    ## cardinality = ~1..inf
    weighted_sound = { sound = <sound>  weight = int }    
}
falloff = {
    name = scalar
    type = enum[falloff_type]
    ## cardinality = 0..1
    min_distance = float
    ## cardinality = 0..1
    max_distance = float
    ## cardinality = 0..1
    height_scale = float
}

soundcategory = {
    name = scalar
    soundeffects = {
        ## cardinality = ~1..inf
        <soundeffect>
    }
    ## cardinality = 0..1
    compressor = {
        ## cardinality = 0..1
        enabled = bool
        ## cardinality = 0..1
        pregain = float
        ## cardinality = 0..1
        postgain = float
        ## cardinality = 0..1
        ratio = float
        ## cardinality = 0..1
        threshold = float
        ## cardinality = 0..1
        attacktime = float
        ## cardinality = 0..1
        releasetime = float
    }
    ## cardinality = 0..1
    compressor = scalar
}

enums = {
    enum[max_audible_behaviours] = {
        fail
        silent
    }
    enum[falloff_type] = {
        linear
        logarithmic
    }
}