
types = {
	type[great_project] = {
		path = "game/common/great_projects"
		localisation = {
			## required
			name = "$"
			## optional
			desc = "$_desc"
		}

		subtype[monument] = {
			type = monument
		}
		subtype[canal] = {
			type = canal
		}
	}
}

great_project = {
	## cardinality = 0..1
	###Province the project starts in.
	start = <province_id>

	###In-game date the monument was built. Will appear if start date is after the specified date.
	date = date_field

	time = {
		months = int
	}
	build_cost = int
	can_be_moved = bool

	## cardinality = 0..1
	move_days_per_unit_distance = int

	###Starting tier of the great project
	starting_tier = int

	subtype[monument] = {
		type = monument
	}
	subtype[canal] = {
		type = canal
	}
	## severity = warning
	## replace_scope = { root = province this = province from = owner }
	###Conditions to build the project. `has_construction = <great_project>` trigger here can cause CTDs.
	build_trigger = {
		alias_name[trigger] = alias_match_left[trigger]
	}

	## cardinality = 0..1
	## replace_scope = { root = province this = province from = owner }
	on_built = {
		## cardinality = 0..1
		add_canal = <great_project.canal>
		## cardinality = 0..2
		show_ambient_object = <great_project>
		## cardinality = 0..2
		show_ambient_object = <ambient_object>
		
		alias_name[effect] = alias_match_left[effect]
	}

	## cardinality = 0..1
	## replace_scope = { root = province this = province from = owner }
	on_destroyed = {
		## cardinality = 0..1
		remove_canal = <great_project.canal>
		## cardinality = 0..2
		hide_ambient_object = <great_project>
		## cardinality = 0..2
		hide_ambient_object = <ambient_object>

		alias_name[effect] = alias_match_left[effect]
	}

	## severity = warning
	## replace_scope = { root = province this = province from = owner }
	can_use_modifiers_trigger = {
		alias_name[trigger] = alias_match_left[trigger]
	}

	## severity = warning
	## replace_scope = { root = province this = province from = owner }
	can_upgrade_trigger = {
		alias_name[trigger] = alias_match_left[trigger]
	}

	## severity = warning
	## replace_scope = { root = province this = province from = owner }
	keep_trigger = {
		alias_name[trigger] = alias_match_left[trigger]
	}

	tier_0 = {
		upgrade_time = {
			enum[days_months_years] = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		cost_to_upgrade = {
			factor = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		province_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		area_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		region_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = country this = country }
		country_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		###Effects to run when the project is upgraded to tier 0
		on_upgraded = {
			alias_name[effect] = alias_match_left[effect]

			## cardinality = 0..1
			add_canal = <great_project.canal>
		}
		## cardinality = 0..inf
		###Modifiers that are applied if the specified conditions are true.
		conditional_modifier = {
			## cardinality = 0..1
			###If true will show the conditional modifier, will be hidden otherwise
			tooltip_potential = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			trigger = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			modifier = {
				alias_name[modifier] = alias_match_left[modifier]
			}
			## cardinality = 0..1
			###Specifies whether the tooltip should list it as positive or not
			is_bad = bool
		}
	}
	tier_1 = {
		upgrade_time = {
			enum[days_months_years] = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		cost_to_upgrade = {
			factor = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		province_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		area_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		region_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = country this = country }
		country_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		###Effects to run when the project is upgraded to tier 1
		on_upgraded = {
			alias_name[effect] = alias_match_left[effect]

			## cardinality = 0..1
			add_canal = <great_project.canal>
		}
		## cardinality = 0..inf
		###Modifiers that are applied if the specified conditions are true.
		conditional_modifier = {
			## cardinality = 0..1
			###If true will show the conditional modifier, will be hidden otherwise
			tooltip_potential = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			trigger = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			modifier = {
				alias_name[modifier] = alias_match_left[modifier]
			}
			## cardinality = 0..1
			###Specifies whether the tooltip should list it as positive or not
			is_bad = bool
		}
	}
	tier_2 = {
		upgrade_time = {
			enum[days_months_years] = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		cost_to_upgrade = {
			factor = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		province_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		area_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		region_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = country this = country }
		country_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		###Effects to run when the project is upgraded to tier 2
		on_upgraded = {
			alias_name[effect] = alias_match_left[effect]

			## cardinality = 0..1
			add_canal = <great_project.canal>
		}
		## cardinality = 0..inf
		###Modifiers that are applied if the specified conditions are true.
		conditional_modifier = {
			## cardinality = 0..1
			###If true will show the conditional modifier, will be hidden otherwise
			tooltip_potential = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			trigger = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			modifier = {
				alias_name[modifier] = alias_match_left[modifier]
			}
			## cardinality = 0..1
			###Specifies whether the tooltip should list it as positive or not
			is_bad = bool
		}
	}
	tier_3 = {
		upgrade_time = {
			enum[days_months_years] = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		cost_to_upgrade = {
			factor = int
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		province_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		area_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		region_modifier = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = country this = country }
		country_modifiers = {
			alias_name[modifier] = alias_match_left[modifier]
		}
		## cardinality = 0..1
		## replace_scope = { root = province this = province }
		###Effects to run when the project is upgraded to tier 3
		on_upgraded = {
			alias_name[effect] = alias_match_left[effect]

			## cardinality = 0..1
			add_canal = <great_project.canal>
		}
		## cardinality = 0..inf
		###Modifiers that are applied if the specified conditions are true.
		conditional_modifier = {
			## cardinality = 0..1
			###If true will show the conditional modifier, will be hidden otherwise
			tooltip_potential = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			trigger = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			modifier = {
				alias_name[modifier] = alias_match_left[modifier]
			}
			## cardinality = 0..1
			###Specifies whether the tooltip should list it as positive or not
			is_bad = bool
		}
	}
}
